# Copy to `.env` — use EXPO_PUBLIC_ for Expo (not NEXT_PUBLIC_ from the Next.js wizard).
# Supabase Dashboard → Connect → copy Project URL + Publishable key.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Legacy anon key name (optional):
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Password reset/auth redirects — Supabase Dashboard → Authentication → URL Configuration:
#   Native Site URL / Redirect URL: enoughapp://auth/callback
#   Web Site URL: https://YOUR_DOMAIN.com
#   Web Redirect URL: https://YOUR_DOMAIN.com/auth/callback
# Use `npx expo run:ios` (development build), not Expo Go, for native email links to open the app.
